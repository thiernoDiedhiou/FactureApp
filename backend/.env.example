# ========================
# Environnement
# ========================
NODE_ENV=production
PORT=5000

# ========================
# Base de données
# ========================
# SQLite (développement uniquement)
# DATABASE_URL="file:./dev.db"

# PostgreSQL (production — obligatoire)
DATABASE_URL="postgresql://user:password@localhost:5432/factureapp"

# ========================
# JWT Configuration
# ========================
# Générer avec : openssl rand -base64 32
JWT_SECRET=CHANGE_ME_min_32_chars_random_string
JWT_EXPIRES_IN=15m
# Générer avec : openssl rand -base64 32  (différent du JWT_SECRET)
REFRESH_TOKEN_SECRET=CHANGE_ME_min_32_chars_different_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

# ========================
# Email (Nodemailer SMTP)
# ========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre.email@gmail.com
# Mot de passe d'application Gmail (pas le mot de passe du compte)
# Générer sur : https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM="CFActure <votre.email@gmail.com>"

# ========================
# Upload fichiers
# ========================
UPLOAD_MAX_SIZE=2097152
UPLOAD_PATH=./uploads

# ========================
# CORS
# ========================
FRONTEND_URL=https://votre-domaine.com

# ========================
# URL publique de l'API
# Utilisée pour : liens PDF, webhooks Money Fusion
# DOIT être HTTPS en production (requis par Money Fusion pour les webhooks)
# ========================
API_BASE_URL=https://api.votre-domaine.com

# ========================
# Rate Limiting
# ========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ========================
# Money Fusion API (paiement mobile money UEMOA)
# Obtenez votre URL API sur : https://moneyfusion.net (dashboard → Mes solutions)
# Format : https://pay.moneyfusion.net/{NomApp}/{AppId}/pay/
# ========================
MONEYFUSION_API_URL=https://pay.moneyfusion.net/VotreApp/votre_app_id/pay/
